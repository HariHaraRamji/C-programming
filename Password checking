#include <stdio.h>
#include<string.h>
#include<stdbool.h>
#include<ctype.h>
int main()
{
    char s[]="HelloWorld123";
    bool digit=false;
    bool up=false;
    bool low=false;
    int n=strlen(s);
    if(n<6){
        printf("Invalid");
        return 0;
    }
    for(int i=0;i<n;i++){
        if(s[i]=='.'||s[i]=='%'||s[i]==','){
            printf("Invalid");
            return 0;
        }
        else if(isdigit(s[i]))digit=true;
        else if(islower(s[i]))low=true;
        else if(isupper(s[i]))up=true;
    }
    if(digit&&up&&low){
        printf("Valid");
    }
    else{
        printf("Invalid");
    }
}
