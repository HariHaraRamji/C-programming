#include <stdio.h>
#include <string.h>

int main()
{
    char s[] = "Programming";
    int n = strlen(s);

    for (int i = 0; i < n; i++)
    {
        int found = 0;

        for (int j = 0; j < i; j++)
        {
            if (s[i] == s[j])
            {
                found = 1;
                break;
            }
        }

        if (found == 0)
        {
            printf("%c", s[i]);
        }
    }

    return 0;
}
