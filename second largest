#include <stdio.h>
#include <limits.h>

int main()
{
    int arr[] = {10, 5, 8, 60, 30, 60};
    int max = INT_MIN;
    int sec = INT_MIN;
    int n = sizeof(arr) / sizeof(arr[0]);

    for (int i = 0; i < n; i++) {
        if (arr[i] > max) {
            sec = max;
            max = arr[i];
        }
        else if (arr[i] < max && arr[i] > sec) {
            sec = arr[i];
        }
    }

    if (sec == INT_MIN)
        printf("No second largest element");
    else
        printf("%d", sec);

    return 0;
}
