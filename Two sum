#include <stdio.h>
int main()
{
    int arr[] = {2, 15, 11, 7, 3};
    int target = 9;
    int n=sizeof(arr)/sizeof(arr[0]);
    for(int i=0;i<n;i++){
        for(int j=0;j<n;j++){
        if(arr[i]+arr[j]==target){
            printf("%d %d",i,j);
            return 0;
        }
        }
            
    }
}
