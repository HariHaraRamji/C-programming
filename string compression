#include <stdio.h>
#include<string.h>
#include<stdlib.h>
int compare(const void*a,const void *b){
    return(*(const char *)a-*(const char *)b);
}
int main()
{
   char c[]="aaaaaabbbbbcccccddddddddddaaaaaaaaabbbbb";
   int n=strlen(c);
   qsort(c,n,sizeof(char),compare);
   int count=1;

   for(int i=0;i<n;i++){
    if(c[i]==c[i+1]){
        count++;
      
    }
    else{
        printf("%c%d",c[i],count);
        count=1;
    }
   }
}
